# ─── Server ────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# Long random string. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# The server refuses to start without it.
JWT_SECRET=

# Where the frontend (leadburd-web) is served from. Comma-separated.
# REQUIRED in production — the frontend runs on its own origin, and without
# this every request from it is blocked by the browser.
CORS_ORIGINS=http://localhost:5173

# ─── Database ──────────────────────────────────────────────────────────────
# Local: run `npm run db:local` in its own terminal and use the URL below.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55432/leadburd

# ─── CVR: Virk Distribution (Erhvervsstyrelsen system-to-system) ───────────
# Credentials are issued by Erhvervsstyrelsen. HTTP Basic auth.
# Without these, bulk extraction returns 503 and only single CVR lookups work.
CVR_PROVIDER=virk
VIRK_USERNAME=
VIRK_PASSWORD=
VIRK_BASE_URL=http://distribution.virk.dk
VIRK_INDEX=cvr-permanent/_search

# Fallback for single lookups when VIRK_* is unset. No key needed.
CVRAPI_USER_AGENT=LeadBurd lead research - support@leadburd.dk

# ─── Compliance ────────────────────────────────────────────────────────────
# CVR marks companies that have opted out of marketing approaches
# ("Reklamebeskyttelse"). Keep this true — excluding them is a legal
# requirement when CVR data is used for marketing.
EXCLUDE_ADVERTISING_PROTECTED=true
